/// Language-neutral contract for TFM analyzer plugins.
///
/// The host owns filesystem, Git, LSP and LLM capabilities. Plugins receive a
/// document and return facts; they get no ambient filesystem or network access.
package tfm:plugin@0.3.0;

interface types {
  record position {
    line: u32,
    column: u32,
  }

  record range {
    start: position,
    end: position,
  }

  record document {
    path: string,
    language: string,
    text: string,
  }

  /// A language-plugin request for read-only semantic context from the host.
  enum context-kind {
    hover,
  }

  record context-hint {
    kind: context-kind,
    range: range,
  }

  record occurrence {
    range: range,
    symbol: option<string>,
    /// Stable AST-local identity used to correlate source-text edits.
    anchor: string,
    /// Language-specific semantic locations the host may inspect through LSP.
    context-hints: list<context-hint>,
  }

  record message {
    source: string,
    occurrences: list<occurrence>,
  }

  record diagnostic {
    message: string,
    range: option<range>,
  }

  record analysis {
    messages: list<message>,
    diagnostics: list<diagnostic>,
  }

  record manifest {
    name: string,
    version: string,
    languages: list<string>,
  }
}

world analyzer {
  use types.{analysis, document, manifest};

  export manifest: async func() -> manifest;
  export analyze: async func(document: document) -> result<analysis, string>;
}
